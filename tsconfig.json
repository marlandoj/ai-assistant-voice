{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "react"
    ],
    "typeRoots": [
      "/__substrate/space/node_modules/@types"
    ],
    "paths": {
      "react": [
        "/__substrate/space/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "/__substrate/space/node_modules/@types/react/jsx-runtime"
      ],
      "hono": [
        "/__substrate/space/node_modules/hono/dist/types/index.d.ts"
      ]
    }
  },
  "include": [
    "assets/pwa-page.tsx",
    "assets/live-route.ts",
    "assets/alaric-mcp-route.ts",
    "assets/realtime-session-route.ts",
    "tests/retrieval.test.ts",
    "tests/live-route.test.ts",
    "scripts/deploy-tts-endpoint.ts"
  ]
}
